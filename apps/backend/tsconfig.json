{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types", "./src/@types"]
  },
  "include": ["src/**/*", "src/@types/**/*.d.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/__tests__/**"]
}
